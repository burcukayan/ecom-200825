{
  "name": "@ecom-backend",
  "version": "1.0.6",
  "description": "Backend for ecommerce application",
  "bin": "./bin/script.js",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts | npx pino-pretty",
    "start": "node dist/src/server.js",
    "test": "jest",
    "test-coverage": "jest --coverage",
    "debug-test": "jest --runInBand --detectOpenHandles",
    "debug-test-coverage": "jest --runInBand --detectOpenHandles --coverage",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit -p .",
    "build": "prisma generate && tsc -p .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "stripe:listen": "stripe listen --forward-to localhost:8000/webhook",
    "prettier-watch": "onchange 'src/**/*.ts' -- prettier --write {{changed}}",
    "prettier:fix": "prettier --write src/**/*.ts",
    "prepare": "husky"
  },
  "author": "Burcu Kayan",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.0",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-oauth2-jwt-bearer": "^1.10.0",
    "helmet": "7.1.0",
    "pino": "8.19.0",
    "resend": "^6.30.0",
    "stripe": "22.6.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/compression": "1.7.5",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "20.11.30",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.3.1",
    "@typescript-eslint/parser": "7.3.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-prettier": "5.1.3",
    "husky": "9.0.11",
    "jest": "29.7.0",
    "nodemon": "3.1.0",
    "onchange": "7.1.0",
    "pino-pretty": "11.0.0",
    "prettier": "3.2.5",
    "prisma": "6.19.0",
    "supertest": "6.3.4",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "typescript": "5.4.3"
  }
}
